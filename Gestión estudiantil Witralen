            </div>
        </div>

    </div>

    <script>
        // BD Local en Memoria (Simulación)
        let usuariosDB = JSON.parse(localStorage.getItem('usuarios_colegio')) || [];
        let usuarioActual = null;

        // Estudiantes de muestra
        let alumnosDB = [
            { id: 101, nombre: "Pérez, Juan Martin", ingreso: 2023, curso: "3", turno: "M", adeudadas: ["Matemática (1°)", "Historia (2°)", "Física (2°)"], notas: { "Matemática": [6, 7, 8] } },
            { id: 102, nombre: "Gómez, Sofía", ingreso: 2024, curso: "3", turno: "M", adeudadas: ["Lengua (1°)"], notas: { "Matemática": [8, 9, 9] } },
            { id: 103, nombre: "Rodríguez, Lucas", ingreso: 2023, curso: "3", turno: "M", adeudadas: ["Matemática (1°)", "Inglés (1°)", "Química (2°)", "Historia (1°)"], notas: { "Matemática": [4, 5, 4] } },
            { id: 104, nombre: "Fernández, Clara", ingreso: 2025, curso: "2", turno: "T", adeudadas: [], notas: { "Lengua": [9, 8, 10] } }
        ];

        function switchAuthTab(tab) {
            document.querySelectorAll('.auth-tab-btn').forEach(b => b.classList.remove('active'));
            if(tab === 'login') {
                document.querySelectorAll('.auth-tab-btn')[0].classList.add('active');
                document.getElementById('loginForm').classList.remove('hidden');
                document.getElementById('registerForm').classList.add('hidden');
            } else {
                document.querySelectorAll('.auth-tab-btn')[1].classList.add('active');
                document.getElementById('loginForm').classList.add('hidden');
                document.getElementById('registerForm').classList.remove('hidden');
            }
        }

        function toggleMasterKeyInput() {
            const role = document.getElementById('loginRole').value;
            const dniGroup = document.getElementById('dniGroup');
            const passHelp = document.getElementById('passHelp');

            if(role === 'directivo' || role === 'secretaria') {
                dniGroup.style.display = 'none';
                passHelp.style.display = 'block';
            } else {
                dniGroup.style.display = 'block';
                passHelp.style.display = 'none';
            }
        }

        function handleRegister(e) {
            e.preventDefault();
            const nuevoUser = {
                nombre: document.getElementById('regNombre').value,
                cargo: document.getElementById('regCargo').value,
                dni: document.getElementById('regDni').value,
                curso: document.getElementById('regCurso').value,
                pass: document.getElementById('regPass').value,
                role: 'auxiliar'
            };

            usuariosDB.push(nuevoUser);
            localStorage.setItem('usuarios_colegio', JSON.stringify(usuariosDB));
            alert('¡Registro exitoso! Ya puede iniciar sesión con sus datos.');
            switchAuthTab('login');
        }

        function handleLogin(e) {
            e.preventDefault();
            const role = document.getElementById('loginRole').value;
            const pass = document.getElementById('loginPass').value;

            if(role === 'directivo' && pass === 'DIRECTOR2026') {
                usuarioActual = { nombre: "Equipo Directivo", role: "Directivo (Pase Libre)" };
            } else if(role === 'secretaria' && pass === 'SECRETARIA2026') {
                usuarioActual = { nombre: "Secretaría Académica", role: "Secretario/a (Pase Libre)" };
            } else if(role === 'auxiliar') {
                const dni = document.getElementById('loginDni').value;
                const user = usuariosDB.find(u => u.dni === dni && u.pass === pass);
                if(user) {
                    usuarioActual = user;
                } else {
                    alert('DNI o Clave de Auxiliar incorrecta. Si es su primera vez, regístrese.');
                    return;
                }
            } else {
                alert('Clave invalida.');
                return;
            }

            iniciarSesionDashboard();
        }

        function iniciarSesionDashboard() {
            document.getElementById('authSection').classList.add('hidden');
            document.getElementById('dashboardSection').classList.remove('hidden');
            document.getElementById('userInfo').classList.remove('hidden');
            
            document.getElementById('userName').innerText = usuarioActual.nombre;
            document.getElementById('userRole').innerText = usuarioActual.role || usuarioActual.cargo;

            // Si es auxiliar, bloquear/limitar controles al curso asignado
            if(usuarioActual.role === 'auxiliar' || usuarioActual.cargo) {
                const [curso, turno] = usuarioActual.curso.split('_');
                document.getElementById('filterCurso').value = curso;
                document.getElementById('filterTurno').value = turno;
            }

            cargarTabla();
        }

        function cerrarSesion() {
            usuarioActual = null;
            document.getElementById('authSection').classList.remove('hidden');
            document.getElementById('dashboardSection').classList.add('hidden');
            document.getElementById('userInfo').classList.add('hidden');
        }

        function cargarTabla() {
            const turno = document.getElementById('filterTurno').value;
            const curso = document.getElementById('filterCurso').value;
            const materia = document.getElementById('filterMateria').value;

            const esDirectivo = !usuarioActual.role || usuarioActual.role.includes('Pase Libre');
            const tbody = document.getElementById('tablaCuerpo');
            tbody.innerHTML = '';

            const filtrados = alumnosDB.filter(a => a.turno === turno && a.curso === curso);

            if(filtrados.length === 0) {
                tbody.innerHTML = `<tr><td colspan="7" style="text-align:center;">No hay alumnos registrados en ${curso}° Año - Turno ${turno === 'M' ? 'Mañana' : 'Tarde'}.</td></tr>`;
                return;
            }

            filtrados.forEach(a => {
                const notasMateria = (a.notas && a.notas[materia]) ? a.notas[materia] : ['-', '-', '-'];
                const adeudadasCount = a.adeudadas.length;
                
                // Semáforo: 3 o más adeudadas = Alerta Roja
                const esRiesgoRojo = adeudadasCount >= 3;
                const claseAdeudada = esRiesgoRojo ? 'status-danger' : '';

                const listaAdeudadasHTML = adeudadasCount > 0 
                    ? a.adeudadas.map(m => `<span class="badge-adeuda">${m}</span>`).join(' ') 
                    : '<small style="color:#38a169;">Sin adeudadas</small>';

                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td><b>${a.nombre}</b></td>
                    <td>${a.ingreso}</td>
                    <td><input type="text" class="input-nota" value="${notasMateria[0]}" ${!esDirectivo ? '' : 'disabled'}></td>
                    <td><input type="text" class="input-nota" value="${notasMateria[1]}" ${!esDirectivo ? '' : 'disabled'}></td>
                    <td><input type="text" class="input-nota" value="${notasMateria[2]}" ${!esDirectivo ? '' : 'disabled'}></td>
                    <td><b>${calcularPromedio(notasMateria)}</b></td>
                    <td class="cell-adeuda ${claseAdeudada}">
                        <b>${adeudadasCount} materia(s)</b><br>
                        ${listaAdeudadasHTML}
                        ${esRiesgoRojo ? '<br>⚠️ <b>ALERTA DE RIESGO</b>' : ''}
                    </td>
                `;
                tbody.appendChild(tr);
            });
        }

        function calcularPromedio(notas) {
            const num = notas.map(n => parseFloat(n)).filter(n => !isNaN(n));
            if(num.length === 0) return '-';
            const sum = num.reduce((a, b) => a + b, 0);
            return (sum / num.length).toFixed(1);
        }

        function guardarNotas() {
            alert('✅ Las valoraciones y cambios han sido guardados correctamente.');
        }
    </script>
</body>
</html>
